# Local DevStack lab credentials — COPY to .env (never commit .env)
# Usage:
#   cp .env.example .env
#   # edit if your VM IP changed
#   set -a && source .env && set +a
#   ./openstack-devstack/scripts/health_check.sh

# Keystone on the UTM Ubuntu VM (Shared Network)
OS_AUTH_URL=http://192.168.64.4/identity/v3
OS_PROJECT_NAME=admin
OS_PROJECT_DOMAIN_NAME=Default
OS_USERNAME=admin
OS_PASSWORD=change-me
OS_USER_DOMAIN_NAME=Default
OS_IDENTITY_API_VERSION=3
OS_INTERFACE=public
OS_REGION_NAME=RegionOne

# Leave empty for username/password auth
OS_CLOUD=
OS_AUTH_TYPE=
